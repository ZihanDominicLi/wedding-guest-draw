POSTGRES_PASSWORD=replace-with-a-long-database-password
DATABASE_URL=postgresql://wedding:replace-with-a-long-database-password@db:5432/wedding
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://wedding.your-domain.com
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
WEDDING_DOMAIN=wedding.your-domain.com
UPLOAD_DIR=/data/uploads
BACKUP_DIR=/data/backups
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_DAYS=14
